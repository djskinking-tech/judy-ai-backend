{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "judy-ai-v22-preview",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-23",
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
