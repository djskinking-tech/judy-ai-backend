{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "judy-ai-v22-preview",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-23",
  "vars": {
    "JUDY_WORKER_ORIGIN": "https://judy-ai-v22-preview.djskinking.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "JUDY_PREDICTIONS",
      "id": "accd39eb76304f4bb5aa48814e0a6113"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
