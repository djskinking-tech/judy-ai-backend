{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "judy-ai-backend-live",
  "main": "worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-11-23",
  "triggers": { "crons": ["*/15 * * * *"] },
  "kv_namespaces": [
    {
      "binding": "JUDY_PREDICTIONS",
      "id": "6b6812a7eec142ab88553b6ca87dda23"
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
